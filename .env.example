# Copy to .env and adjust. Never commit .env.

# Isolation — unique per clone/machine so start/stop never touches other stacks
COMPOSE_PROJECT_NAME=tools-transcript-dev
STACK_SUFFIX=dev

# Whisper ggml model name (tiny, base, small, medium, large, ...)
WHISPER_MODEL=medium

# Optional spoken language (ISO code, case-insensitive: en, es, auto, ...)
# WHISPER_LANGUAGE=es

# Used by bin/start.sh urls hint if HTTP ports are enabled later
PUBLIC_HOST=localhost

# Leave empty for v1 (no published ports). Set to 0 for random host port when HTTP is added.
# TRANSCRIPT_HOST_PORT=
